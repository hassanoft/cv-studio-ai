# ==========================================
# CV Studio AI — Variables d'environnement
# ==========================================

# --- Telegram ---
BOT_TOKEN=123456789:ABCDEF_votre_token_botfather

# Mode de fonctionnement du bot : "polling" (Termux / local) ou "webhook" (Render / production)
BOT_MODE=polling

# Requis uniquement si BOT_MODE=webhook (ex: https://cv-studio-ai.onrender.com)
WEBHOOK_URL=
# Chemin secret du webhook (laisser tel quel ou personnaliser)
WEBHOOK_PATH=/telegram/webhook

# --- Serveur Express ---
PORT=3000
# URL publique de base utilisee pour generer les liens de portfolio (sans slash final)
PUBLIC_BASE_URL=http://localhost:3000

# --- Administration ---
# Liste des IDs Telegram admin, separes par des virgules (ex: 111111,222222)
ADMIN_IDS=

# --- Base de donnees ---
DB_PATH=./database/data/cvstudio.sqlite

# --- Paiement Wave (validation manuelle) ---
WAVE_PAYMENT_LINK=https://pay.wave.com/m/M_ci_knlRyepWBd4f/c/ci/?amount=

# --- Puppeteer (Render / Linux) ---
# Laisser vide pour utiliser le Chromium telecharge par Puppeteer.
# Sur certains environnements (Render, Termux avec navigateur systeme), definir le chemin d'un binaire existant.
PUPPETEER_EXECUTABLE_PATH=

# --- Divers ---
NODE_ENV=development
